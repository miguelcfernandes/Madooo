# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so it must never hold real values.

# API-Football, from https://dashboard.api-football.com
API_FOOTBALL_KEY=

# Neon, pooled connection strings (the hostname contains "-pooler").
# One per branch — a Neon branch is a separate endpoint, so there is no way to
# select one from a single URL. The direct connection string that migrations
# need is derived from these by dropping "-pooler" from the hostname.
#
# End these with sslmode=verify-full, not the sslmode=require Neon hands you.
# pg treats "require" as "verify-full" today but warns that it will adopt
# libpq's weaker meaning — encrypt without verifying who answered — in v9.
# Spelling out what is already happening keeps that upgrade from silently
# downgrading the connection.
DATABASE_URL=
DATABASE_URL_DEV=

# Everything defaults to the development branch. Production is reached only by
# setting this, and it is set in exactly one place: Vercel's Production
# environment, which the scheduled sync now runs inside. Leave it commented out here — it should
# never be set on a developer's machine. Migrating production from a laptop is
# a one-off `DATABASE_TARGET=production npx prisma migrate deploy`, where the
# variable sits in front of the single command it is meant for and nowhere else.
# DATABASE_TARGET=production

# Vercel's Production environment holds API_FOOTBALL_KEY and LEAGUES, and this
# file used to say at length that it never would. That changed when the schedule
# moved from GitHub Actions to a Vercel cron job: the sync is now a route in the
# deployment, so the credential it needs has to be in the deployment.
#
# What that cost is worth knowing. The key's absence used to *be* the guarantee
# that no page reaches API-Football — code that tried threw on its first run.
# Now the guarantee is a rule: src/app/api/cron/sync/route.ts is the only file
# under src/app/ allowed to touch either variable. It is stated in AGENTS.md,
# in docs/architecture.md and beside apiFootballKey() in src/lib/env.ts.
#
# Where each variable lives, then, is three places:
#
#   .env.local          every variable below — a laptop runs the app and the sync
#   Vercel Production   DATABASE_TARGET, DATABASE_URL, SEASON, LEAGUES,
#                       API_FOOTBALL_KEY, CRON_SECRET, the *live* Clerk keys
#   Vercel Preview      DATABASE_URL_DEV, SEASON, the *test* Clerk keys — and no
#                       DATABASE_TARGET, which is what keeps a preview off the
#                       production branch. No key and no CRON_SECRET: cron jobs
#                       run against production deployments only, so a preview has
#                       no sync to feed.
#
# The two branches are not two copies of one thing. Production holds only the
# configured season and is filled by the scheduled sync; development still holds
# 2024 from the free-tier era, and nothing fills it on a timer — you do, with
# `npm run sync -- --due`, when you want a preview or a laptop to see current
# football.
#
# So SEASON and LEAGUES have two homes and can disagree: the copy below governs a
# sync run by hand, Vercel Production's copy governs every scheduled one. Change
# both.

# Guards the cron route, which is otherwise a URL anyone could fetch. Vercel
# sends it as `Authorization: Bearer …` on scheduled invocations and generates
# one for you when you add it in the dashboard. Any long random string will do:
# `openssl rand -hex 32`. Only needed on Vercel Production and, if you want to
# curl the route locally, here.
# CRON_SECRET=

# Escape hatches, only needed if Neon ever stops deriving its direct endpoint
# from the pooled hostname. Leave unset.
# DATABASE_URL_UNPOOLED=
# DATABASE_URL_DEV_UNPOOLED=

# The season to run against — the year the season starts in, so 2026 is 2026-27.
# Never hardcode this anywhere. A free-tier key only serves seasons roughly two
# years back and will refuse a newer one inside an HTTP 200; `python3
# scripts/verify_api.py` reports the newest season your key can actually fetch.
SEASON=2026

# Which leagues the sync fetches — API-Football's ids, in the order they are
# synced and printed. 39 is the Premier League, 94 the Primeira Liga, 140 the
# competition API-Football calls La Liga, 135 Serie A, 78 the Bundesliga, 61
# Ligue 1 and 113 Allsvenskan.
#
# Read by the sync alone. Every page discovers its leagues from our own League
# table instead, so adding a league is this variable and a sync run — here and in
# Vercel Production, which is where the scheduled sync reads it, and no page
# needs telling. Entitlement is per
# league as well as per season, so check a new id with
# `python3 scripts/verify_api.py --league <id>` before adding it.
#
# A club's colour does not arrive with the league: API-Football publishes none,
# and the chip falls back to neutral until somebody says what the club plays in.
# `npm run colours` is the screen that asks.
LEAGUES=39,94,140,135,78,61,113

# Clerk, from https://dashboard.clerk.com. The publishable key is inlined into
# the browser bundle by the NEXT_PUBLIC_ prefix and is meant to be public — it
# identifies the Clerk instance, it does not authorise anything. The secret key
# must never carry that prefix.
#
# Use the DEVELOPMENT instance's keys here — the pk_test_/sk_test_ pair. The
# production instance's pk_live_/sk_live_ keys are locked to madooo.app and
# Clerk refuses them on localhost, so they belong only in Vercel's Production
# environment. Both keys must come from the same instance: a live publishable
# key with a test secret signs in fine in the browser and then throws inside the
# proxy, which reports itself as x-clerk-auth-reason: unexpected-error.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Where the modal sends people once they are signed in. Without these you stay
# on the landing page after signing in, since the modal never navigated. There
# is deliberately no NEXT_PUBLIC_CLERK_SIGN_IN_URL: sign-in is a modal, not a
# route, so pointing Clerk at a page that does not exist would 404.
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/fixtures
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/fixtures

# Vercel needs all four of the above in addition to DATABASE_URL_DEV and SEASON,
# with the two Clerk keys set per environment: the live pair on Production, this
# test pair on Preview. Vercel treats CLERK_SECRET_KEY as sensitive and will not
# apply it to its Development environment, which nothing here reads anyway.
