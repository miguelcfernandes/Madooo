// Madooo's schema.
//
// Designed against the captured payloads in scratch/ — fixtures_2024.json,
// lineup_1208021.json and players_1208021.json — rather than from memory.
//
// Two rules from AGENTS.md shape it:
//   - The season is configuration. Match.season is a column, never a literal.
//   - API-Football's IDs stop at the sync boundary. Everything sourced from
//     them carries apiFootballId alongside our own primary key.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // Strips file extensions from the generated imports, which Next's bundler
  // needs in order to resolve them.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum JudgementTag {
  MVP
  STANDOUT
  FLOP
}

model League {
  id            Int     @id @default(autoincrement())
  apiFootballId Int     @unique
  name          String
  /// API-Football's country name, verbatim: "England", "Portugal", "Spain".
  /// Read by `flagClass`, so its spelling is load-bearing on the read side —
  /// a provider rename degrades to a league with no flag.
  country       String
  logo          String?

  matches     Match[]
  totwScopes  TeamOfTheWeekLeague[]
}

model Team {
  id            Int     @id @default(autoincrement())
  apiFootballId Int     @unique
  name          String
  logo          String?

  // The design puts a three-letter code on a club-coloured rectangle where a
  // crest would go. Neither field comes from API-Football, which publishes no
  // codes and no club colours — they are ours, entered by hand and keyed to
  // apiFootballId by `npm run db:seed-teams`. Nullable because a team arrives
  // from a sync before anyone has assigned it an identity, and a club with no
  // identity falls back rather than failing.
  //
  // `colour` keeps its leading "#", unlike MatchLineup's kit hexes. Those are
  // stored as the provider sends them; this one is ours and is consumed
  // directly as a CSS colour.
  code   String? // "MUN" — the official Premier League abbreviation
  colour String? // "#da2128"

  // Back-relations. Prisma requires both ends of every relation to be declared
  // and will not generate a client otherwise. These hold no foreign key and
  // produce no column — they exist so the relation can be traversed from this
  // side, the way Django hands you `team.matchlineup_set` for free.
  homeMatches   Match[]       @relation("HomeTeam")
  awayMatches   Match[]       @relation("AwayTeam")
  matchLineups  MatchLineup[]
  squadEntries  MatchSquad[]
}

model Player {
  id            Int     @id @default(autoincrement())
  apiFootballId Int     @unique
  // The full name, from /fixtures/players. The lineups endpoint abbreviates it
  // to "A. Onana", which is not what a diary should show.
  name          String
  photo         String?

  squadEntries MatchSquad[]
}

model Match {
  id            Int @id @default(autoincrement())
  apiFootballId Int @unique

  leagueId Int
  league   League @relation(fields: [leagueId], references: [id])
  season   Int
  round    String // "Regular Season - 1"

  kickoff       DateTime // ISO 8601 with an explicit UTC offset in the payload
  status        String // status.short, e.g. "FT"
  statusElapsed Int?

  venueApiFootballId Int?
  venueName          String?
  venueCity          String?
  referee            String?

  homeTeamId Int
  homeTeam   Team @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId Int
  awayTeam   Team @relation("AwayTeam", fields: [awayTeamId], references: [id])

  homeGoals         Int?
  awayGoals         Int?
  homeHalftimeGoals Int?
  awayHalftimeGoals Int?

  /// Moves on any write to this row, the calendar's included, because it is
  /// `@updatedAt`. So it answers "is this row stale", never "have we read the
  /// team sheet" — the calendar re-reads every fixture of the season on every
  /// scheduled run, which would keep this fresh for a match nobody has hydrated.
  syncedAt DateTime @updatedAt

  /// When the two per-fixture detail endpoints were last read for this match.
  /// Written by `syncFixtureDetail` alone, and only when squad rows came back:
  /// stamping a fixture whose lineup the provider has not published yet would
  /// retire it from the queue and leave the card reading "No squad yet" forever.
  ///
  /// A timestamp rather than a boolean because the scheduled run needs to know
  /// *when*. A reading taken minutes after full time can catch the provider
  /// mid-write, so `hydration.ts` re-reads a match until it has been read at
  /// least six hours past kickoff. Null means never read.
  hydratedAt DateTime?

  lineups      MatchLineup[]
  squadEntries MatchSquad[] // ~40 rows, 20 per side

  @@index([leagueId, season, round])
  @@index([kickoff])
}

/// One team's shape in one match. From /fixtures/lineups.
model MatchLineup {
  id      Int   @id @default(autoincrement())
  matchId Int
  match   Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId  Int
  team    Team  @relation(fields: [teamId], references: [id])

  formation          String? // "4-2-3-1"
  coachApiFootballId Int?
  coachName          String?

  // The kit worn in this match — hex without the leading "#", e.g. "ea0000".
  // Two kits because the goalkeeper never matches the outfield players; three
  // parts each because they describe a drawable player chip: shirt fill, the
  // number printed on it, and the outline. Per-match rather than per-team,
  // since home and away kits differ.
  kitPlayerPrimary     String?
  kitPlayerNumber      String?
  kitPlayerBorder      String?
  kitGoalkeeperPrimary String?
  kitGoalkeeperNumber  String?
  kitGoalkeeperBorder  String?

  @@unique([matchId, teamId])
}

/// A player's involvement in one match — precisely the set a user may judge.
/// Includes unused substitutes: a diary is a private judgement and needs no
/// justification in minutes played.
model MatchSquad {
  id       Int    @id @default(autoincrement())
  matchId  Int
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId   Int
  team     Team   @relation(fields: [teamId], references: [id])
  playerId Int
  player   Player @relation(fields: [playerId], references: [id])

  shirtNumber Int?
  position    String? // "G" | "D" | "M" | "F"
  isStarter   Boolean @default(false)
  grid        String? // "row:column"; null for substitutes
  minutes     Int? // null = named in the squad but did not appear

  // Per-match statistics. Every one is nullable because absent and zero are
  // different facts: an unused substitute did not score zero goals, they have no
  // goals figure at all. The API sends null for most statistics for most
  // players, and the UI must be able to tell the two apart.
  //
  // Float rather than Decimal for `rating`: it arrives as the string "7.2", and
  // Prisma hands Decimal columns back as Decimal.js objects, which are awkward
  // to compare and format for one decimal place of precision.
  goals   Int?
  assists Int?
  yellow  Int?
  red     Int?
  rating  Float?

  judgements Judgement[]
  totwPicks  TeamOfTheWeekPick[]

  @@unique([matchId, playerId])
  @@index([playerId])
}

model User {
  id        Int      @id @default(autoincrement())
  clerkId   String   @unique
  email     String?
  createdAt DateTime @default(now())

  judgements     Judgement[]
  suggestions    Suggestion[]
  teamsOfTheWeek TeamOfTheWeek[]
}

/// Something a user asked us to build or change, sent from the top bar.
///
/// The only table in the schema that nothing in the app reads back. It is
/// written by `sendSuggestion` and read by `npm run suggestions` from a laptop,
/// which is deliberate: a suggestion is addressed to the author, not to the
/// other users, so there is no screen for it and no moderation problem to have.
model Suggestion {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Unbounded `text`. The length limit is `SUGGESTION_MAX_LENGTH`, enforced by
  /// the action — a product rule rather than a schema one, the same split
  /// `Judgement.note` makes. A hand-added CHECK does insist it is not blank.
  body String

  createdAt DateTime @default(now())

  /// The script reads newest-first across every user, which is the only query
  /// anything makes against this table.
  @@index([createdAt])
}

model Judgement {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Pointing at MatchSquad rather than at (player, match) means the unique
  // constraint below delivers "one judgement per user per player per match"
  // *and* makes it structurally impossible to judge someone who was not in the
  // squad. One constraint, two guarantees.
  matchSquadId Int
  matchSquad   MatchSquad @relation(fields: [matchSquadId], references: [id], onDelete: Cascade)

  // Both nullable: a note with no tag is a valid judgement. A CHECK constraint
  // added by hand in the initial migration requires at least one of them.
  tag  JudgementTag?
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, matchSquadId])
  @@index([userId, createdAt])
}

/// One team of the week: an eleven a user picked out of their own diary, over a
/// span of days.
///
/// **The formation is not a column, because it is not a fact this table has to
/// hold.** A saved team is eleven picks, each pointing at a squad row that
/// carries a position, so the shape — 4-3-3, 3-5-2 — is the count of those
/// positions and is derived on read. A stored `"4-3-3"` would be a second
/// statement of the same thing, free to disagree with the picks under it, and it
/// would break every saved team on the day a formation was taken out of the
/// table the builder offers.
model TeamOfTheWeek {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// What the reader called it. Required, because every card in the list is
  /// headed by it and a nameless one would be a card with a hole in it — the
  /// dialog that writes this always opens with a suggestion already in the box,
  /// so there is no path to an empty name that is not deliberate.
  ///
  /// The length limit is `TOTW_NAME_MAX_LENGTH`, enforced by the action — a
  /// product rule rather than a schema one, the same split `Judgement.note` and
  /// `Suggestion.body` make. A hand-added CHECK does insist it is not blank.
  name String

  /// Configuration, exactly as `Match.season` is. Implied by the days below,
  /// and stored anyway so this table can be filtered the way every other screen
  /// filters — by season, not by a date range that has to be derived first.
  season Int

  /// The span, inclusive, as London calendar days — `"2026-08-17"`, the same
  /// key `/fixtures` is indexed by. Strings rather than timestamps because a
  /// day is what the reader chose: a `DateTime` would need a zone to be read
  /// back in, and there is exactly one right answer for every reader, which is
  /// the zone `dates.ts` already pins. A hand-added CHECK requires from <= to,
  /// which on ISO day keys is chronological order.
  fromDay String
  toDay   String

  createdAt DateTime @default(now())

  picks   TeamOfTheWeekPick[]
  leagues TeamOfTheWeekLeague[]

  /// The index the list page's only query is written around.
  @@index([userId, createdAt])
}

/// A competition this team of the week was picked from.
///
/// **A row per competition rather than an `Int[]` column**, because the list
/// page draws each one's flag and would otherwise have to resolve names against
/// a second query it does not otherwise need. It is also the shape that cannot
/// hold an id no league has.
///
/// **The set is what the reader ticked, not a claim about coverage.** There is
/// no "all competitions" flag: a team drawn from every league the app held that
/// day stores every one of them, and the list says "All" only while that set is
/// still every league there is. When an eighth league arrives, an older team
/// starts listing seven flags instead — which is the truth about it, and is
/// exactly what a stored boolean would have got wrong.
model TeamOfTheWeekLeague {
  teamOfTheWeekId Int
  teamOfTheWeek   TeamOfTheWeek @relation(fields: [teamOfTheWeekId], references: [id], onDelete: Cascade)
  leagueId        Int
  league          League        @relation(fields: [leagueId], references: [id])

  /// No surrogate key: the pair *is* the row, and the composite primary key is
  /// what makes a competition impossible to list twice.
  @@id([teamOfTheWeekId, leagueId])
}

/// One player in one team of the week.
///
/// Points at `MatchSquad` rather than at `Player`, for `Judgement`'s reason: a
/// team of the week is a verdict on *performances*, so a pick is the performance
/// that earned the place, and pointing at the squad row makes it structurally
/// impossible to pick somebody who was not in a matchday squad. It also carries
/// the club, the shirt number and the position the graphic draws, with no second
/// lookup.
model TeamOfTheWeekPick {
  id              Int           @id @default(autoincrement())
  teamOfTheWeekId Int
  teamOfTheWeek   TeamOfTheWeek @relation(fields: [teamOfTheWeekId], references: [id], onDelete: Cascade)

  matchSquadId Int
  matchSquad   MatchSquad @relation(fields: [matchSquadId], references: [id], onDelete: Cascade)

  /// MVP or STANDOUT, **frozen at the moment the team was saved** rather than
  /// read back off the judgement.
  ///
  /// The one piece of denormalisation in the schema, and it is deliberate: a
  /// team of the week is a thing the reader made and may have screenshotted, so
  /// editing a verdict in the diary afterwards must not silently restar
  /// somebody on a graphic that has already left the app. The judgement is a
  /// live opinion; this is a record of what that opinion was that week.
  tag JudgementTag

  /// Where this pick sits in the eleven, 0–10, goalkeeper first and then the
  /// lines up the pitch. Only the order *within* a line is a decision — which
  /// line a pick belongs to comes from `MatchSquad.position`, so this is a
  /// left-to-right placement rather than a second opinion about position.
  order Int

  /// One place per performance, and one performance per place.
  @@unique([teamOfTheWeekId, matchSquadId])
  @@unique([teamOfTheWeekId, order])
}
